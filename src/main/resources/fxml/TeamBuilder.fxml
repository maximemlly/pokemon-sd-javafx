<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.TeamBuilderController"
      prefHeight="600.0" prefWidth="800.0"
      spacing="10.0">
    
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    
    <!-- Titre -->
    <Label text="Créer votre équipe de Pokémon" 
           style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
    
    <!-- Barre d'outils -->
    <HBox spacing="10.0">
        <ComboBox fx:id="pokemonSelector" promptText="Choisir un Pokémon" HBox.hgrow="ALWAYS"/>
        <Button fx:id="addButton" text="Ajouter" onAction="#addPokemon"/>
        <Button fx:id="removeButton" text="Retirer" onAction="#removePokemon"/>
        <Button fx:id="startButton" text="Commencer le combat" 
                onAction="#startBattle" disable="true"/>
    </HBox>
    
    <!-- Liste des Pokémon de l'équipe -->
    <Label text="Votre Équipe:" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" prefHeight="200.0">
        <VBox fx:id="teamContainer" spacing="10.0"/>
    </ScrollPane>
    
    <!-- Sélecteur de moves pour le Pokémon sélectionné -->
    <Separator/>
    <Label text="Choisir les attaques du Pokémon:" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
    <GridPane hgap="10.0" vgap="5.0">
        <columnConstraints>
            <ColumnConstraints percentWidth="40"/>
            <ColumnConstraints percentWidth="60"/>
        </columnConstraints>
        
        <Label text="Slot 1:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <ComboBox fx:id="moveSlot1" GridPane.rowIndex="0" GridPane.columnIndex="1" promptText="Choisir une attaque"/>
        
        <Label text="Slot 2:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <ComboBox fx:id="moveSlot2" GridPane.rowIndex="1" GridPane.columnIndex="1" promptText="Choisir une attaque"/>
        
        <Label text="Slot 3:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <ComboBox fx:id="moveSlot3" GridPane.rowIndex="2" GridPane.columnIndex="1" promptText="Choisir une attaque"/>
        
        <Label text="Slot 4:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <ComboBox fx:id="moveSlot4" GridPane.rowIndex="3" GridPane.columnIndex="1" promptText="Choisir une attaque"/>
    </GridPane>
    
    <!-- Bouton pour appliquer les moves -->
    <Button fx:id="applyMovesButton" text="Appliquer les attaques" onAction="#applyMoves"/>
    
    <!-- Informations -->
    <HBox spacing="10.0">
        <Label fx:id="teamCountLabel" text="Équipe: 0/6"/>
        <Label fx:id="statusLabel" text="" style="-fx-text-fill: green;"/>
    </HBox>
</VBox>