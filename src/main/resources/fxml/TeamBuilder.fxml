<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.TeamBuilderController"
      prefHeight="600.0" prefWidth="800.0"
      spacing="10.0">
    
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    
    <!-- Titre -->
    <Label text="Créer votre équipe de Pokémon" 
           style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
    
    <!-- Barre d'outils -->
    <HBox spacing="10.0">
        <ComboBox fx:id="pokemonSelector" promptText="Choisir un Pokémon"/>
        <Button fx:id="addButton" text="Ajouter" onAction="#addPokemon"/>
        <Button fx:id="removeButton" text="Retirer" onAction="#removePokemon"/>
        <Button fx:id="startButton" text="Commencer le combat" 
                onAction="#startBattle" disable="true"/>
    </HBox>
    
    <!-- Liste des Pokémon de l'équipe -->
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
        <VBox fx:id="teamContainer" spacing="10.0"/>
    </ScrollPane>
    
    <!-- Informations -->
    <HBox spacing="10.0">
        <Label fx:id="teamCountLabel" text="Équipe: 0/6"/>
        <Label fx:id="statusLabel" text="" style="-fx-text-fill: green;"/>
    </HBox>
</VBox>